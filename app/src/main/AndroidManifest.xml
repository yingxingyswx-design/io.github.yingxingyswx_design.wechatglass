<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ package visibility: we only need to see the module we
         integrate (WeChat-LiquidGlass) and the LSPosed manager. -->
    <queries>
        <package android:name="io.github.liuran001.mmliquidglass" />
        <package android:name="org.lsposed.manager" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="微信NewUI"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name="com.wechatglass.SettingsActivity"
            android:exported="true"
            android:label="微信NewUI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="微信 NewUI：M3E 通讯录/发现/我 + 液态玻璃首页与聊天页（仅界面，不含通讯/支付逻辑）" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposedscope" />

        <provider
            android:name="com.wechatglass.ConfigProvider"
            android:authorities="io.github.yingxingyswx_design.wechatglass.config"
            android:exported="true" />
    </application>
</manifest>
